# ===== DM'S CX 운영 CRM 환경변수 =====

# true  : Google Sheets 없이 localStorage / mock 데이터로 동작 (개발/테스트용)
# false : 서버 API 를 통해 실제 Google Sheets 에 저장/조회
NEXT_PUBLIC_USE_MOCK_DATA=true

# Google Sheets 연동에 필요한 값 (NEXT_PUBLIC_USE_MOCK_DATA=false 일 때 사용)
# 스프레드시트 ID (시트 URL 의 /d/ 와 /edit 사이 문자열)
GOOGLE_SHEET_ID=

# 서비스 계정 이메일 (예: my-crm@my-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정 private key. 줄바꿈은 \n 으로 escape 하고 전체를 큰따옴표로 감쌉니다.
# 예) GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=


# ===== 랜딩페이지(/) · 문의 접수 · 어드민(/admin) 환경변수 =====

# 어드민(/admin) 로그인 비밀번호. 운영에서는 반드시 강력한 값으로 설정하세요.
ADMIN_PASSWORD=change-me-now
# (선택) 세션 쿠키 서명 비밀. 미설정 시 ADMIN_PASSWORD 로 파생됩니다. 별도 지정 권장.
ADMIN_SECRET=

# 문의 폼 스팸 방지: IP 당 분당 제출 제한 (기본 5)
INQUIRY_RATE_PER_MINUTE=5

# 문의/사이트설정 영구 저장(Vercel KV·Upstash). Vercel 에서 KV 를 연결하면 자동 주입됩니다.
# 미설정 시 인메모리로 동작(콜드스타트 시 초기화) — 웹훅/알림톡으로 유실 방지 권장.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# (선택) 서버 측 연동 비밀값 — 클라이언트에 노출되지 않음
GA4_API_SECRET=
META_CAPI_TOKEN=
MSG_PROVIDER_URL=
MSG_API_KEY=
MSG_API_SECRET=
